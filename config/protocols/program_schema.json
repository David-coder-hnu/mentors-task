{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Composed probing program",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "steps", "count"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{2,63}$"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "fraction"],
        "properties": {
          "target": {
            "enum": ["balanced", "least_probed", "unprobed", "responsive"]
          },
          "fraction": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
